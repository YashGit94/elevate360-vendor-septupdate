FROM node:20-alpine
WORKDIR /app

# Copy package files and install production dependencies
COPY package*.json ./
RUN npm install --only=production

# Copy backend source code
COPY src/index.js ./src/

# IMPORTANT: For Cloud Run, do NOT bundle keys.json. 
# Instead, use Application Default Credentials (ADC) by granting 
# the Cloud Run service account the 'BigQuery Data Viewer' role.

# The backend listens on port 3001 as defined in index.js
# Cloud Run expects the app to listen on the $PORT environment variable
ENV PORT=3001
EXPOSE 3001

CMD ["node", "src/index.js"]
